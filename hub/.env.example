# Hub MaisTODOS — variáveis de ambiente.
#
# REGRA DURA: nada com valor real entra em arquivo versionado.
# Segredo vive no Environment do projeto no Dokploy e é lido com process.env
# dentro de código de servidor. Nenhum token chega ao navegador.
#
# Prefixo NEXT_PUBLIC_ vai para o bundle do navegador em texto claro.
# Use apenas para o que pode ser público.

# --- Aplicação ---
APP_URL="http://localhost:3000"
NODE_ENV="development"

# --- Banco ---
# Postgres com a extensão pgvector habilitada.
DATABASE_URL="postgres://usuario:senha@localhost:5432/hub"

# --- Autenticação Google Workspace ---
# O login é restrito ao domínio corporativo: o parâmetro hd trava na origem e a
# validação é repetida no servidor, porque hd sozinho não é garantia.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_HOSTED_DOMAIN="maistodos.com.br"

# Segredo de assinatura da sessão (cookie httpOnly). Gerar com:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=""

# --- Convenia (fonte de RH: setor, nível e produto) ---
# São três empresas, cada uma com token próprio, e o escopo precisa ser completo.
# Formato: [{"empresa":"CredTodos","token":"..."}, ...]
# Sem sandbox: só existe produção. Toda operação é de leitura.
CONVENIA_API_TOKENS=""
CONVENIA_BASE_URL="https://public-api.convenia.com.br/api/v3"
# A Convenia está atrás de Cloudflare e recusa cliente sem User-Agent de navegador.
CONVENIA_USER_AGENT=""
# Pausa entre chamadas, em ms. Abaixo de 350 o rate limit derruba a rodada inteira.
CONVENIA_PAUSA_MS="400"
# Segredo do webhook. A fórmula da assinatura ainda não foi confirmada com a
# Convenia: enquanto isso, o endpoint não confia no evento e sempre refaz a busca.
CONVENIA_WEBHOOK_SECRET=""

# --- Notion (base de conhecimento) ---
# Sincroniza apenas os espaços da allowlist, nunca o workspace inteiro.
NOTION_TOKENS=""
NOTION_ESPACOS_PERMITIDOS=""

# --- Integrações de atendimento ---
# Credenciais rotacionadas, entregues direto no cofre do ambiente.
CDT_BASE_URL="https://api.cartaodetodos.com.br/api"
CDT_TOKEN=""
WALLET_BASE_URL="https://wallet.maistodos.com.br/api"
WALLET_USUARIO=""
WALLET_SENHA=""
SOLATIO_BASE_URL="https://server.solatioenergialivre.com.br/ProspectorAPI"
SOLATIO_TOKEN=""

# --- Assistente Maísa ---
IA_PROVEDOR=""
IA_MODELO_CHAT=""
IA_MODELO_EMBEDDING=""
IA_API_KEY=""

# --- Cron interno ---
# Autentica as rotinas de sincronização. Chave privilegiada não serve para isso.
CRON_SECRET=""
